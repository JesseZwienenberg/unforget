{
  "name": "unforget",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace app",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "e2e": "npm run e2e --workspace app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
